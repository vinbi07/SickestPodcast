# Production canonical origin (defaults to the production domain if unset — see content/site.ts)
NEXT_PUBLIC_SITE_URL=https://thesickestpodcast.com

# Booking form submission endpoint (Formspree/Getform/etc). Leave unset to show the
# "not configured yet, email support@sickfitofficial.com" fallback message.
NEXT_PUBLIC_BOOKING_ENDPOINT=

# End of Season Party RSVPs → Google Sheets. Server-side only — NEVER prefix these
# with NEXT_PUBLIC_. Setup guide: docs/end-of-season-party-setup.md
# Spreadsheet ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# "client_email" from the service account JSON key file
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# "private_key" from the service account JSON key file. Keep the \n escapes and the quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# Optional worksheet (tab) name. Defaults to "End of Season Party RSVPs".
GOOGLE_SHEET_TAB=
